# Plantilla de variables de entorno del backend.
#
# Copia este archivo como `.env` y rellena los valores reales:
#
#     cp .env.example .env
#
# El `.env` real está en `.gitignore` y NO debe subirse nunca al repositorio.

# Puerto en el que escucha la API. El cliente Flutter lo espera en 3333
# (ver `urlBasePorDefecto` en app_vecino_seguro/lib/servicios/cliente_api.dart).
PORT=3333

# Clave con la que se firman los JWT.
#
# Mínimo 32 caracteres: el arranque avisa por debajo de eso en desarrollo y
# falla en producción (ver src/config/entorno.ts).
#
# Genera una aleatoria, no la escribas a mano:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Cambiarla invalida todas las sesiones abiertas: los tokens ya emitidos dejan
# de verificar y los vecinos tendrán que volver a ingresar.
JWT_SECRET=

# Cadena de conexión de PostgreSQL.
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/vecinoseguro

# Ruta al JSON de credenciales de servicio de Firebase Admin, para las
# notificaciones push.
#
# Es un archivo de credenciales: guárdalo FUERA del repositorio. Si falta, la
# app arranca igual y las alertas se siguen viendo en el muro y en la bandeja;
# solo se pierden los avisos push.
FIREBASE_CREDENCIALES=C:/ruta/a/tu/vecino-seguro-admin.json
