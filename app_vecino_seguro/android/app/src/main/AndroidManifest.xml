<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Red -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Notificaciones: obligatorio pedirlo desde Android 13 (API 33) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Botón de pánico: el servicio en primer plano es lo que permite detectar
         el gesto con la app cerrada y la pantalla bloqueada. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <!-- location: tipo exento sin condiciones adicionales en Android 15+ cuando
         el usuario cierra la app desde recientes. Aplica porque el servicio
         habilita alertas de emergencia con coordenadas adjuntas. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- Relanzar el servicio tras reiniciar el teléfono: sin esto, el pánico
         dejaría de funcionar en silencio después de cada reinicio. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Exención de optimización de batería: sin ella el sistema mata el
         servicio y el gesto deja de detectarse. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <!-- Notificación de pantalla completa al detectar el gesto: es lo que
         enciende la pantalla y muestra la cuenta atrás sobre la pantalla de
         bloqueo. Obligatorio desde Android 14 (API 34). El usuario debe
         habilitarlo en Ajustes → Aplicaciones → Vecino Seguro → Permisos. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>

    <!-- Ubicación de la emergencia. Se solicita SOLO al emitir una alerta, y
         solo en uso: nunca en segundo plano. Opcional por diseño — la alerta
         sale igual sin coordenadas, porque no enviarla sería mucho peor. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <application
        android:label="Vecino Seguro"
        android:usesCleartextTraffic="${permitirTraficoSinCifrar}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:showWhenLocked="true"
            android:turnScreenOn="true">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Servicio del botón de pánico.
             `location`: tipo exento sin condiciones en Android 15+ cuando el
             usuario cierra la app (otros tipos requieren comandos del usuario o
             permisos Bluetooth). `mediaPlayback` mantiene la sesión de medios
             que intercepta las teclas de volumen con la pantalla apagada. -->
        <service
            android:name=".ServicioPanico"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="location|mediaPlayback" />

        <!-- Relanza el servicio al encender el teléfono -->
        <receiver
            android:name=".ReceptorArranque"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
